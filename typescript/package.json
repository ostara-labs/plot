{
  "name": "@ostara-labs/plot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run check:i18n && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "format": "biome format --write .",
    "pretypecheck": "svelte-kit sync && paraglide-js compile --project ./project.inlang",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && pnpm run check:i18n",
    "check": "pnpm run typecheck",
    "check:i18n": "node scripts/check-i18n.ts"
  },
  "dependencies": {
    "@inlang/paraglide-js": "^2.25.0",
    "@skeletonlabs/skeleton": "^5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.3",
    "@tailwindcss/vite": "^4.3.3",
    "maplibre-gl": "^5.24.0",
    "svelte": "^5.57.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "@types/node": "^26.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte-check": "^4.7.6",
    "vite": "^8.2.2"
  },
  "version": "0.3.0"
}
