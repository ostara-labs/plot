# Copy this file to .env and fill in real values. Never commit .env.
# .env is gitignored; .env.example is the only committed template.

APP_ENV=development
LOG_LEVEL=info

# PostgreSQL + PostGIS (backend)
# postgres://user:pass@host:5432/plot
DATABASE_URL=

# Auth (FastAPI Users) — JWT signing + lifetime
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Transactional email — Postmark (data res. US; DPA/SCCs in their terms)
POSTMARK_API_KEY=
POSTMARK_SENDER_EMAIL=noreply@ostara-labs.com

# Transactional SMS — SMSemode (France; ARCEP direct routing)
SMSEMODE_API_KEY=
SMSEMODE_SENDER_ID=PLOT

# External open data sources (no API key required — see docs/SOURCES.md)
# IGN / Géorisques / ADEME / Hub'Eau are public REST endpoints; base URLs
# are configured in the backend, overridable per environment.
IGN_BASE_URL=https://wxs.ign.fr/
GEORISQUES_BASE_URL=https://www.georisques.gouv.fr/api/v1
ADEME_BASE_URL=https://data.ademe.fr/data-fair/api
HUBEAU_BASE_URL=https://hubeau.eaufrance.fr/api/v1

# Analytics (Plausible, self-hosted or cloud)
PLAUSIBLE_DOMAIN=plot.fr
PLAUSIBLE_SITE_ID=plot

# Monitoring (Sentry)
SENTRY_DSN=
